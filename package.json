{
  "name": "multi-project-creator",
  "displayName": "Multi-Project Creator",
  "description": "创建多个基于不同 Git 分支的工作区，支持工程模板管理与基于文件系统扫描的已有需求管理",
  "version": "1.4.0",
  "publisher": "caixy123",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "git",
    "workspace",
    "project",
    "branch",
    "multi-project",
    "clone"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cxyxiaoyi/multi-project-creator"
  },
  "homepage": "https://github.com/cxyxiaoyi/multi-project-creator#readme",
  "bugs": {
    "url": "https://github.com/cxyxiaoyi/multi-project-creator/issues"
  },
  "license": "MIT",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "multiProjectCreator.createProject",
        "title": "Multi-Project Creator: Create Project",
        "category": "Multi-Project Creator"
      },
      {
        "command": "multiProjectCreator.listProjects",
        "title": "Multi-Project Creator: List Projects",
        "category": "Multi-Project Creator"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "multiProjectCreator",
          "title": "Multi-Project Creator",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "multiProjectCreator": [
        {
          "id": "projectExplorer",
          "name": "Projects"
        }
      ]
    },
    "keybindings": [
      {
        "command": "multiProjectCreator.createProject",
        "key": "ctrl+alt+w",
        "mac": "cmd+control+w"
      },
      {
        "command": "multiProjectCreator.listProjects",
        "key": "ctrl+alt+l",
        "mac": "cmd+control+l"
      }
    ],
    "configuration": {
      "title": "Multi-Project Creator",
      "properties": {
        "multiProjectCreator.defaultWorkspace": {
          "type": "string",
          "default": "",
          "description": "Default workspace directory for new projects"
        },
        "multiProjectCreator.savedProjects": {
          "type": "array",
          "default": [],
          "description": "Saved project configurations"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {}
}
